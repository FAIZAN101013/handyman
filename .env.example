# Copy this file to .env and fill in real values. NEVER commit .env to git.

# Django settings
DJANGO_SECRET_KEY=generate-one-with--python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Production only — full origins (with https://) allowed to POST forms.
# On Render this is filled in automatically from RENDER_EXTERNAL_HOSTNAME.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com

# Database (optional — defaults to local sqlite if unset)
# DATABASE_URL=postgres://user:password@host:5432/database_name

# Email (Gmail requires an App Password: https://myaccount.google.com/apppasswords)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com
